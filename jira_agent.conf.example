# JIRA agent 配置模板 — 复制为 jira_agent.conf 并填写真实值
# jira_agent.conf 已加入 .gitignore，不会被提交到 git
#
# 每个 section 是一个组的数字员工，对应该组服务器 B 上的一个 codex app-server。
# 网站只保存连接信息；组知识、skills、Codex 与 SSH 凭证都在服务器 B 上。

[HPC]
DISPLAY_NAME = HPC 数字员工

# B 上 codex app-server 的 WebSocket 地址，以及 capability token
# （与 B 上 --ws-token-file 文件内容一致）
CODEX_WS_URL = ws://127.0.0.1:4510
CODEX_WS_TOKEN =

# B 上的任务工作目录根，必须是绝对路径，位于知识包目录（PACK_DIR）之下
WORKSPACE_ROOT = /home/hpc-agent/hpc-jira-agent/workspaces

# 该组负责的 JIRA component（逗号分隔），用于为工单选择数字员工
COMPONENTS = PDE_HPC

# 可选：覆盖 B 上 codex 的默认模型
MODEL =

# 每轮最长执行时间（秒），从出队开始计算
TURN_TIMEOUT_SECONDS = 7200

# 该组 B 上同时运行的轮次数
MAX_CONCURRENT = 2
