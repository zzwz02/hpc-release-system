{
  "release_phases": {
    "before_app_freeze": {
      "label": "App 冻结前",
      "order": 0,
      "locked": false,
      "before_app_freeze": true,
      "before_doc_deadline": true,
      "qa_scope_frozen": false
    },
    "after_app_freeze": {
      "label": "App 冻结后",
      "order": 1,
      "locked": false,
      "before_app_freeze": false,
      "before_doc_deadline": true,
      "qa_scope_frozen": true
    },
    "after_doc_deadline": {
      "label": "Doc deadline 后",
      "order": 2,
      "locked": false,
      "before_app_freeze": false,
      "before_doc_deadline": false,
      "qa_scope_frozen": true
    },
    "released_locked": {
      "label": "已最终锁定",
      "order": 3,
      "locked": true,
      "before_app_freeze": false,
      "before_doc_deadline": false,
      "qa_scope_frozen": true
    }
  },
  "release_decisions": {
    "release": {
      "label": "release：进入 release note/文档/QA",
      "order": 0,
      "cicd_status": "Running"
    },
    "cicd_only": {
      "label": "cicd_only：仅纳入 CICD 构建/测试管控",
      "order": 1,
      "cicd_status": "Running"
    },
    "stopped": {
      "label": "stopped：停止维护/停止发布",
      "order": 2,
      "cicd_status": "Stopped"
    }
  },
  "doc_targets": {
    "manual": {
      "label": "HPC",
      "order": 0,
      "default": true,
      "aliases": ["HPC", "hpc"]
    },
    "ai4sci": {
      "label": "AI4Sci",
      "order": 1,
      "default": false,
      "aliases": ["AI4Sci", "AI4SCI"]
    }
  },
  "qa_statuses": {
    "not_checked": {
      "label": "未测试",
      "order": 0,
      "default": true,
      "issue_note_required": false,
      "releasable": false,
      "issue_note_prefix": ""
    },
    "qa_passed": {
      "label": "通过",
      "order": 1,
      "default": false,
      "issue_note_required": false,
      "releasable": true,
      "issue_note_prefix": ""
    },
    "has_issues": {
      "label": "存在问题",
      "order": 2,
      "default": false,
      "issue_note_required": true,
      "releasable": true,
      "issue_note_prefix": "QA 备注"
    },
    "cannot_release": {
      "label": "不可发布",
      "order": 3,
      "default": false,
      "issue_note_required": true,
      "releasable": false,
      "issue_note_prefix": "QA 不可发布"
    }
  },
  "cicd_config": {
    "default_test_timeout": 40,
    "repo_types": {
      "git": {
        "label": "git",
        "order": 0,
        "default": true
      },
      "repo": {
        "label": "repo",
        "order": 1,
        "default": false
      }
    },
    "community_artifacts": {
      "image": {
        "label": "镜像",
        "order": 0,
        "aliases": ["镜像"]
      },
      "pkg": {
        "label": "软件包",
        "order": 1,
        "aliases": ["package", "软件包"]
      }
    },
    "app_fields": {
      "cicd_repo_type": {
        "payload_field": "repo_type",
        "label": "仓库类型"
      },
      "cicd_community_artifact": {
        "payload_field": "community_artifact",
        "label": "开发者社区产物"
      },
      "cicd_build_image": {
        "payload_field": "build_image",
        "label": "构建依赖镜像"
      },
      "cicd_test_timeout": {
        "payload_field": "test_timeout",
        "label": "超时(min)"
      },
      "cicd_notes": {
        "payload_field": "notes",
        "label": "备注"
      }
    }
  },
